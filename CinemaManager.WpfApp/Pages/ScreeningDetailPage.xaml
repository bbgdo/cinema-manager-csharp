<Page x:Class="CinemaManager.Wpf.Pages.ScreeningDetailPage"
      xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
      xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
      Title="Screening Detail">

    <Grid>
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="*"/>
        </Grid.RowDefinitions>

        <Border Grid.Row="0" Padding="36 20 36 20"
                BorderThickness="0 0 0 1" BorderBrush="{StaticResource BorderCol}"
                Background="{StaticResource BgHeader}">
            <Button Content="&#8592;  Back to Hall" Style="{StaticResource BackBtn}"
                    HorizontalAlignment="Left" Command="{Binding BackCommand}"/>
        </Border>

        <ScrollViewer Grid.Row="1" VerticalScrollBarVisibility="Auto">
            <Grid Margin="36 34 36 36">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="Auto"/>
                    <ColumnDefinition Width="*"/>
                </Grid.ColumnDefinitions>

                <Border Grid.Column="0" CornerRadius="12" VerticalAlignment="Top"
                        Margin="0 0 38 0" Effect="{StaticResource PosterShadow}">
                    <Border CornerRadius="12" ClipToBounds="True" Width="210" Height="315">
                        <Grid>
                            <Border>
                                <Border.Background>
                                    <LinearGradientBrush StartPoint="0,0" EndPoint="0,1">
                                        <GradientStop Color="#252542" Offset="0"/>
                                        <GradientStop Color="#0C0C14" Offset="1"/>
                                    </LinearGradientBrush>
                                </Border.Background>
                            </Border>
                            <TextBlock Text="&#127909;" FontSize="44"
                                       HorizontalAlignment="Center" VerticalAlignment="Center"
                                       Foreground="{StaticResource FgSubtle}"/>
                            <Image Source="{Binding Screening.PosterFileName, Converter={StaticResource PosterConverter}}"
                                   Stretch="UniformToFill"
                                   RenderOptions.BitmapScalingMode="HighQuality"/>
                        </Grid>
                    </Border>
                </Border>

                <StackPanel Grid.Column="1" VerticalAlignment="Top">

                    <TextBlock Text="{Binding Screening.MovieTitle}"
                               FontSize="27" FontWeight="Bold"
                               TextWrapping="Wrap" Margin="0 0 0 6"/>
                    <TextBlock Text="{Binding Screening.ReleaseYear}"
                               FontSize="15" Foreground="{StaticResource FgMuted}"
                               Margin="0 0 0 16"/>

                    <StackPanel Orientation="Horizontal" Margin="0 0 0 26">
                        <Border CornerRadius="6" Padding="11 5" Margin="0 0 8 0"
                                Background="{StaticResource BgGenreChip}">
                            <TextBlock Text="{Binding Screening.GenreDisplay}"
                                       FontSize="12" Foreground="{StaticResource AccentAmber}"/>
                        </Border>
                        <Border CornerRadius="6" Padding="11 5"
                                Background="{StaticResource BgInfoChip}">
                            <TextBlock FontSize="12" Foreground="{StaticResource FgMuted}">
                                <Run Text="{Binding Screening.DurationMinutes, Mode=OneWay}"/>
                                <Run Text=" min"/>
                            </TextBlock>
                        </Border>
                    </StackPanel>

                    <Border Background="{StaticResource BgCard}" CornerRadius="12" Padding="22 18">
                        <Grid>
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="90"/>
                                <ColumnDefinition Width="*"/>
                            </Grid.ColumnDefinitions>
                            <Grid.RowDefinitions>
                                <RowDefinition Height="Auto"/>
                                <RowDefinition Height="Auto"/>
                                <RowDefinition Height="Auto"/>
                                <RowDefinition Height="Auto"/>
                            </Grid.RowDefinitions>

                            <TextBlock Grid.Row="0" Grid.Column="0" Text="Hall"
                                       Foreground="{StaticResource FgMuted}" FontSize="13"
                                       Margin="0 0 0 13"/>
                            <TextBlock Grid.Row="0" Grid.Column="1" Text="{Binding HallName}"
                                       FontSize="13" Margin="0 0 0 13"/>

                            <TextBlock Grid.Row="1" Grid.Column="0" Text="Starts"
                                       Foreground="{StaticResource FgMuted}" FontSize="13"
                                       Margin="0 0 0 13"/>
                            <TextBlock Grid.Row="1" Grid.Column="1" FontSize="13"
                                       Text="{Binding Screening.StartTimeDisplay}"
                                       Margin="0 0 0 13"/>

                            <TextBlock Grid.Row="2" Grid.Column="0" Text="Ends"
                                       Foreground="{StaticResource FgMuted}" FontSize="13"
                                       Margin="0 0 0 13"/>
                            <TextBlock Grid.Row="2" Grid.Column="1" FontSize="13"
                                       Text="{Binding Screening.EndTimeDisplay}"
                                       Margin="0 0 0 13"/>

                            <TextBlock Grid.Row="3" Grid.Column="0" Text="Duration"
                                       Foreground="{StaticResource FgMuted}" FontSize="13"/>
                            <TextBlock Grid.Row="3" Grid.Column="1" FontSize="13">
                                <Run Text="{Binding Screening.DurationMinutes, Mode=OneWay}"/>
                                <Run Text=" min"/>
                            </TextBlock>
                        </Grid>
                    </Border>

                </StackPanel>
            </Grid>
        </ScrollViewer>
    </Grid>
</Page>
