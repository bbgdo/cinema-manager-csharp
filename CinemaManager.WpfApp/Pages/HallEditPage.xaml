<Page x:Class="CinemaManager.Wpf.Pages.HallEditPage"
      xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
      xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
      Title="Hall">

    <Grid>
        <Grid>
            <Grid.RowDefinitions>
                <RowDefinition Height="Auto"/>
                <RowDefinition Height="*"/>
            </Grid.RowDefinitions>

            <Border Grid.Row="0" Padding="36 20 36 20"
                    BorderThickness="0 0 0 1" BorderBrush="{StaticResource BorderCol}"
                    Background="{StaticResource BgHeader}">
                <Grid>
                    <Button Content="&#8592; Cancel" Style="{StaticResource BackBtn}"
                            Command="{Binding CancelCommand}"
                            HorizontalAlignment="Left" VerticalAlignment="Center"/>
                    <TextBlock Text="{Binding Title}" FontSize="18" FontWeight="SemiBold"
                               HorizontalAlignment="Center" VerticalAlignment="Center"/>
                </Grid>
            </Border>

            <ScrollViewer Grid.Row="1" VerticalScrollBarVisibility="Auto">
                <StackPanel Margin="36 32 36 32" MaxWidth="480" HorizontalAlignment="Left">

                    <TextBlock Text="HALL NAME" Style="{StaticResource FieldLbl}"/>
                    <TextBox Text="{Binding Name, UpdateSourceTrigger=PropertyChanged}"
                             Style="{StaticResource FieldTxt}" Margin="0 0 0 20"/>

                    <TextBlock Text="SEATS" Style="{StaticResource FieldLbl}"/>
                    <TextBox Text="{Binding SeatsCount, UpdateSourceTrigger=PropertyChanged}"
                             Style="{StaticResource FieldTxt}" Margin="0 0 0 20"/>

                    <TextBlock Text="HALL TYPE" Style="{StaticResource FieldLbl}"/>
                    <ComboBox ItemsSource="{Binding HallTypeOptions}"
                              SelectedValue="{Binding HallType}"
                              SelectedValuePath="Value"
                              DisplayMemberPath="Display"
                              Style="{StaticResource FieldCmb}"
                              Margin="0 0 0 32"/>

                    <StackPanel Orientation="Horizontal">
                        <Button Content="Save" Command="{Binding SaveCommand}"
                                Style="{StaticResource PrimaryBtn}" Margin="0 0 12 0"/>
                        <Button Content="Cancel" Command="{Binding CancelCommand}"
                                Style="{StaticResource SecondaryBtn}"/>
                    </StackPanel>

                </StackPanel>
            </ScrollViewer>
        </Grid>

        <Border Style="{StaticResource ErrorBanner}"
                Visibility="{Binding HasError, Converter={StaticResource BoolToVis}}">
            <TextBlock Text="{Binding ErrorMessage}" TextWrapping="Wrap"
                       Foreground="{StaticResource Accent}" FontSize="13"/>
        </Border>

        <Border Style="{StaticResource BusyOverlay}"
                Visibility="{Binding IsBusy, Converter={StaticResource BoolToVis}}">
            <ProgressBar Style="{StaticResource IndeterminateBar}"
                         HorizontalAlignment="Center" VerticalAlignment="Center"/>
        </Border>
    </Grid>
</Page>
