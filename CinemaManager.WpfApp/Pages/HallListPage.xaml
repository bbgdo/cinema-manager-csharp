<Page x:Class="CinemaManager.Wpf.Pages.HallListPage"
      xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
      xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
      Title="Cinema Halls">

    <Grid>
        <Grid>
            <Grid.RowDefinitions>
                <RowDefinition Height="Auto"/>
                <RowDefinition Height="Auto"/>
                <RowDefinition Height="*"/>
            </Grid.RowDefinitions>

            <Border Grid.Row="0" Padding="36 30 36 26"
                    BorderThickness="0 0 0 1" BorderBrush="{StaticResource BorderCol}">
                <Border.Background>
                    <LinearGradientBrush StartPoint="0,0" EndPoint="1,1">
                        <GradientStop Color="#16162A" Offset="0"/>
                        <GradientStop Color="#0C0C14" Offset="1"/>
                    </LinearGradientBrush>
                </Border.Background>
                <Grid>
                    <StackPanel>
                        <TextBlock Text="&#127909;  CINEMA MANAGER"
                                   FontSize="11" FontWeight="SemiBold" Foreground="{StaticResource Accent}"
                                   Margin="0 0 0 10"/>
                        <TextBlock Text="Now Showing"
                                   FontSize="32" FontWeight="Bold" Margin="0 0 0 5"/>
                        <TextBlock Text="Select a hall to browse its screenings"
                                   FontSize="13" Foreground="{StaticResource FgMuted}"/>
                    </StackPanel>
                    <Button Content="+ New Hall" Style="{StaticResource PrimaryBtn}"
                            Command="{Binding AddHallCommand}"
                            VerticalAlignment="Center" HorizontalAlignment="Right"/>
                </Grid>
            </Border>

            <Grid Grid.Row="1" Margin="36 14 20 10">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="200"/>
                    <ColumnDefinition Width="130"/>
                    <ColumnDefinition Width="150"/>
                    <ColumnDefinition Width="*"/>
                </Grid.ColumnDefinitions>
                <TextBox Grid.Column="0"
                         Text="{Binding SearchText, UpdateSourceTrigger=PropertyChanged}"
                         Style="{StaticResource FieldTxt}"
                         Margin="0 0 10 0"/>
                <ComboBox Grid.Column="1"
                          ItemsSource="{Binding HallTypeFilterOptions}"
                          SelectedItem="{Binding HallTypeFilter}"
                          DisplayMemberPath="Display"
                          Style="{StaticResource FieldCmb}"
                          Margin="0 0 10 0"/>
                <ComboBox Grid.Column="2"
                          ItemsSource="{Binding SortOptions}"
                          SelectedValue="{Binding SelectedSort}"
                          SelectedValuePath="Value"
                          DisplayMemberPath="Display"
                          Style="{StaticResource FieldCmb}"/>
            </Grid>

            <ScrollViewer Grid.Row="2" VerticalScrollBarVisibility="Auto">
                <ListBox x:Name="HallListBox"
                         Margin="36 18 20 28"
                         ItemsSource="{Binding HallsView}"
                         Style="{StaticResource CleanLB}"
                         ItemContainerStyle="{StaticResource CleanLBI}"
                         SelectionChanged="HallListBox_SelectionChanged">
                    <ListBox.ItemsPanel>
                        <ItemsPanelTemplate>
                            <WrapPanel/>
                        </ItemsPanelTemplate>
                    </ListBox.ItemsPanel>
                    <ListBox.ItemTemplate>
                        <DataTemplate>
                            <Border Margin="0 0 18 18" CornerRadius="14"
                                    Effect="{StaticResource CardShadow}">
                                <Border x:Name="Card" CornerRadius="14" Width="224"
                                        Background="{StaticResource BgCard}"
                                        Cursor="Hand" Padding="22 20">
                                    <StackPanel>
                                        <Border CornerRadius="5" Padding="9 4"
                                                HorizontalAlignment="Left"
                                                Background="{Binding HallTypeDisplay, Converter={StaticResource HallBadgeColor}}">
                                            <TextBlock Text="{Binding HallTypeDisplay}"
                                                       FontSize="11" FontWeight="SemiBold"
                                                       Foreground="White"/>
                                        </Border>

                                        <TextBlock Text="{Binding Name}"
                                                   FontSize="16" FontWeight="SemiBold"
                                                   Margin="0 12 0 5" TextWrapping="Wrap"/>

                                        <TextBlock FontSize="13" Foreground="{StaticResource FgMuted}">
                                            <Run Text="{Binding SeatsCount, Mode=OneWay}"/>
                                            <Run Text=" seats"/>
                                        </TextBlock>
                                    </StackPanel>
                                </Border>
                            </Border>

                            <DataTemplate.Triggers>
                                <Trigger SourceName="Card" Property="IsMouseOver" Value="True">
                                    <Setter TargetName="Card" Property="Background"
                                            Value="{StaticResource BgCardHov}"/>
                                </Trigger>
                            </DataTemplate.Triggers>
                        </DataTemplate>
                    </ListBox.ItemTemplate>
                </ListBox>
            </ScrollViewer>
        </Grid>

        <Border Style="{StaticResource ErrorBanner}"
                Visibility="{Binding HasError, Converter={StaticResource BoolToVis}}">
            <TextBlock Text="{Binding ErrorMessage}" TextWrapping="Wrap"
                       Foreground="{StaticResource Accent}" FontSize="13"/>
        </Border>

        <Border Style="{StaticResource BusyOverlay}"
                Visibility="{Binding IsBusy, Converter={StaticResource BoolToVis}}">
            <ProgressBar Style="{StaticResource IndeterminateBar}"
                         HorizontalAlignment="Center" VerticalAlignment="Center"/>
        </Border>
    </Grid>
</Page>
